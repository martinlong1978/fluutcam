// Spike S4: the FluutCAM window in slint (S 08 §8.2). Same panels and fields
// as spikes/s4-egui. Slint has no docking, so the panels are a fixed layout.

import { LineEdit, ComboBox, CheckBox, ScrollView } from "std-widgets.slint";

// Brand colours (assets/README.md) and derived surfaces, as design tokens.
export global Theme {
    out property <color> ink: #16181D;
    out property <color> orange: #FF5B14;
    out property <color> grey: #8A93A0;
    out property <color> paper: #F4F2EE;
    out property <color> panel: #1E2128;
    out property <color> raised: #272B34;
    out property <color> line: #333842;
    out property <color> amber: #F2B134;
    out property <color> red: #E5484D;
    out property <color> green: #4CC38A;
    out property <length> font-small: 11px;
    out property <length> font: 13px;
}

export struct RibbonGroup { name: string, gallery: bool, commands: [string] }

// One row of the browser tree, flattened. status: -1 = Setup row.
export struct TreeRow {
    depth: int,
    text: string,
    status: int,
    status-label: string,
    progress: float,
    selected: bool,
    expanded: bool,
    setup: int,
    toolpath: int,
}

export struct Clip { name: string, selected: bool }

component Segmented inherits HorizontalLayout {
    in property <[string]> options;
    in property <int> current;
    in property <string> label;
    callback select(int);
    spacing: 4px;
    for opt[i] in options: Rectangle {
        accessible-role: button;
        accessible-label: root.label + ": " + opt;
        accessible-checked: i == root.current;
        accessible-action-default => { root.select(i); }
        border-radius: 4px;
        height: 24px;
        min-width: t.preferred-width + 16px;
        background: i == root.current ? Theme.orange : (ta.has-hover ? Theme.raised : transparent);
        t := Text {
            text: opt;
            color: i == root.current ? Theme.ink : Theme.paper;
            font-size: Theme.font;
            vertical-alignment: center;
        }
        ta := TouchArea { clicked => { root.select(i); } }
    }
}

// Numeric field: drag the label to scrub, or type a value or expression.
component ScrubField inherits VerticalLayout {
    in property <string> label;
    in property <string> value-text;
    in property <string> message;
    in property <bool> error;
    callback scrub(length);
    callback entered(string);
    spacing: 2px;
    // Typing into the LineEdit replaces its `text` binding, so the shown text
    // is pushed from the value whenever the value changes.
    changed value-text => { edit.text = self.value-text; }
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 90px;
            accessible-role: text;
            accessible-label: root.label;
            lbl := Text {
                x: 0;
                text: root.label;
                color: scrub-area.has-hover ? Theme.orange : Theme.paper;
                font-size: Theme.font;
                vertical-alignment: center;
            }
            scrub-area := TouchArea {
                mouse-cursor: ew-resize;
                property <length> last-x;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) { self.last-x = self.mouse-x; }
                }
                moved => {
                    root.scrub(self.mouse-x - self.last-x);
                    self.last-x = self.mouse-x;
                }
            }
        }
        edit := LineEdit {
            text: root.value-text;
            accessible-label: root.label;
            accepted(t) => {
                root.entered(t);
                self.text = root.value-text;
            }
        }
    }
    if root.message != "": Text {
        text: (root.error ? "Error: " : "Warning: ") + root.message;
        color: root.error ? Theme.red : Theme.amber;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }
}

component StatusIcon inherits Rectangle {
    in property <int> status;
    in property <float> progress;
    property <color> icol: status == 0 ? Theme.grey : (status == 1 || status == 2) ? Theme.green : (status == 3 || status == 4) ? Theme.amber : Theme.red;
    width: 14px;
    height: 14px;
    // 0 not calculated: ring; 2 done: disc; 3 stale: ring with dot;
    // 1 calculating: ring with a progress arc; 4 warning: open triangle; 5 error: solid triangle.
    if status <= 3: Rectangle {
        width: 11px;
        height: 11px;
        border-radius: 5.5px;
        border-width: 1.5px;
        border-color: status == 1 ? Theme.line : root.icol;
        background: status == 2 ? root.icol : transparent;
    }
    if status == 3: Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: root.icol; }
    if status == 1: Path {
        width: 11px;
        height: 11px;
        stroke: root.icol;
        stroke-width: 2px;
        viewbox-width: 2; viewbox-height: 2; viewbox-x: -1; viewbox-y: -1;
        MoveTo { x: 0; y: -1; }
        ArcTo { x: sin(root.progress * 360deg); y: -cos(root.progress * 360deg); radius-x: 1; radius-y: 1; sweep: true; large-arc: root.progress > 0.5; }
    }
    if status >= 4: Path {
        width: 12px;
        height: 11px;
        commands: "M 6 0 L 12 11 L 0 11 Z";
        fill: status == 5 ? root.icol : transparent;
        stroke: root.icol;
        stroke-width: 1.5px;
    }
}

export component AppWindow inherits Window {
    title: "FluutCAM — slint prototype";
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Theme.ink;
    default-font-size: Theme.font;

    // Title bar and ribbon.
    in property <string> units: "mm";
    in-out property <bool> decimal-comma;
    in property <[string]> stages;
    in-out property <int> stage: 2;
    in property <[RibbonGroup]> ribbon;
    callback stage-selected(int);
    callback toggle-units();
    callback toggle-comma();

    // Browser and timeline.
    in property <[TreeRow]> tree;
    in property <[Clip]> clips;
    callback row-clicked(int, int);

    // Viewport.
    in property <image> viewport-image;
    out property <length> viewport-width: vp.width;
    out property <length> viewport-height: vp.height;
    in property <string> triad-x;
    in property <string> triad-y;
    in property <string> triad-z;
    in property <length> zero-x;
    in property <length> zero-y;
    callback viewport-drag(PointerEventButton, length, length);
    callback viewport-zoom(length);

    // Inspector.
    in property <string> item-name;
    in property <string> item-kind;
    in property <string> tool-name;
    in property <int> pattern;
    in property <int> direction;
    in property <int> offset-order;
    in property <string> stepover-text;
    in property <string> stepover-message;
    in property <bool> stepover-error;
    in property <string> step-down-text;
    in property <string> step-down-message;
    in property <bool> step-down-error;
    in property <string> angle-text;
    in-out property <bool> preview: true;
    callback pattern-selected(int);
    callback direction-selected(int);
    callback offset-order-selected(int);
    callback field-scrub(string, length);
    callback field-entered(string, string);
    callback preview-toggled();

    VerticalLayout {
        // Title bar.
        Rectangle {
            background: Theme.ink;
            height: 34px;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: start;
                Rectangle { width: 14px; Rectangle { width: 12px; height: 12px; border-radius: 6px; background: Theme.orange; } }
                Text { text: "FluutCAM"; color: Theme.paper; font-weight: 700; vertical-alignment: center; }
                Text { text: "Relief.fluut"; color: Theme.grey; vertical-alignment: center; }
                Rectangle { width: 40px; }
                LineEdit { width: 320px; placeholder-text: "Ctrl+K  Search commands…"; }
            }
            HorizontalLayout {
                alignment: end;
                padding-right: 8px;
                spacing: 8px;
                Rectangle {
                    accessible-role: button;
                    accessible-label: "Project units " + root.units;
                    accessible-action-default => { root.toggle-units(); }
                    width: 34px;
                    y: 6px;
                    height: 22px;
                    border-radius: 3px;
                    background: Theme.grey;
                    Text { text: root.units; color: Theme.ink; font-weight: 700; }
                    TouchArea { clicked => { root.toggle-units(); } }
                }
                CheckBox {
                    text: "Decimal comma";
                    checked: root.decimal-comma;
                    toggled => { root.toggle-comma(); }
                }
            }
        }
        // Ribbon.
        Rectangle {
            background: Theme.raised;
            vertical-stretch: 0;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    for s[i] in root.stages: Rectangle {
                        accessible-role: tab;
                        accessible-label: s;
                        accessible-action-default => { root.stage-selected(i); }
                        min-width: st.preferred-width;
                        height: 20px;
                        st := Text {
                            text: s;
                            color: i == root.stage ? Theme.orange : Theme.grey;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.stage-selected(i); } }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for g in root.ribbon: Rectangle {
                        background: Theme.panel;
                        border-radius: 6px;
                        VerticalLayout {
                            padding: 6px;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                for cmd in g.commands: Rectangle {
                                    accessible-role: button;
                                    accessible-label: g.name + " " + cmd;
                                    width: g.gallery ? 72px : 64px;
                                    height: 52px;
                                    border-radius: 4px;
                                    background: cta.has-hover ? Theme.line : Theme.raised;
                                    border-width: cta.has-hover ? 1px : 0;
                                    border-color: Theme.orange;
                                    if g.gallery: Rectangle {
                                        y: 6px;
                                        width: 12px;
                                        height: 12px;
                                        border-radius: 2px;
                                        border-width: 1.5px;
                                        border-color: Theme.orange;
                                    }
                                    Text { y: g.gallery ? 24px : 18px; text: cmd; color: Theme.paper; }
                                    cta := TouchArea { }
                                }
                            }
                            Text { text: g.name; color: Theme.grey; font-size: Theme.font-small; }
                        }
                    }
                }
            }
        }
        // Browser, viewport, inspector.
        HorizontalLayout {
            spacing: 2px;
            vertical-stretch: 1;
            Rectangle {
                width: 260px;
                background: Theme.panel;
                VerticalLayout {
                    Rectangle {
                        height: 26px;
                        background: Theme.raised;
                        Text { x: 8px; text: "Browser"; color: Theme.paper; }
                    }
                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            padding: 4px;
                            for row in root.tree: Rectangle {
                                accessible-role: list-item;
                                accessible-label: row.text + (row.status >= 0 ? ", " + row.status-label : "");
                                accessible-item-selected: row.selected;
                                accessible-action-default => { root.row-clicked(row.setup, row.toolpath); }
                                height: 24px;
                                HorizontalLayout {
                                    padding-left: 4px + row.depth * 16px;
                                    spacing: 6px;
                                    if row.status < 0: Text {
                                        text: row.expanded ? "▾" : "▸";
                                        color: Theme.grey;
                                        vertical-alignment: center;
                                    }
                                    if row.status >= 0: StatusIcon {
                                        status: row.status;
                                        progress: row.progress;
                                        y: 5px;
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        border-radius: 3px;
                                        background: row.selected ? Theme.orange.with-alpha(0.45) : (rta.has-hover ? Theme.raised : transparent);
                                        Text {
                                            x: 4px;
                                            text: row.text;
                                            color: Theme.paper;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                rta := TouchArea { clicked => { root.row-clicked(row.setup, row.toolpath); } }
                            }
                        }
                    }
                }
            }
            vp := Rectangle {
                horizontal-stretch: 1;
                background: Theme.ink;
                accessible-role: image;
                accessible-label: "3-D viewport";
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.viewport-image;
                    image-fit: fill;
                }
                for p[i] in [{ c: root.triad-x, col: Theme.red }, { c: root.triad-y, col: Theme.green }, { c: root.triad-z, col: #4C8DF6 }]: Path {
                    x: 0;
                    y: 0;
                    width: vp.width;
                    height: vp.height;
                    viewbox-width: vp.width / 1px;
                    viewbox-height: vp.height / 1px;
                    commands: p.c;
                    stroke: p.col;
                    stroke-width: 2.5px;
                }
                vta := TouchArea {
                    property <length> last-x;
                    property <length> last-y;
                    property <PointerEventButton> button;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            self.last-x = self.mouse-x;
                            self.last-y = self.mouse-y;
                            self.button = e.button;
                        }
                    }
                    moved => {
                        root.viewport-drag(self.button, self.mouse-x - self.last-x, self.mouse-y - self.last-y);
                        self.last-x = self.mouse-x;
                        self.last-y = self.mouse-y;
                    }
                    scroll-event(e) => {
                        root.viewport-zoom(e.delta-y);
                        accept
                    }
                }
                // Work-zero handle, above the viewport touch area.
                Rectangle {
                    x: root.zero-x - 6px;
                    y: root.zero-y - 6px;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    border-width: 1.5px;
                    border-color: Theme.ink;
                    background: hta.has-hover ? Theme.orange : Theme.paper;
                    hta := TouchArea { }
                }
                Text {
                    x: 10px;
                    y: parent.height - 24px;
                    text: "Drag: orbit · right/middle drag: pan · wheel: zoom";
                    color: Theme.grey;
                    font-size: 12px;
                }
            }
            Rectangle {
                width: 320px;
                background: Theme.panel;
                VerticalLayout {
                    Rectangle {
                        height: 26px;
                        background: Theme.raised;
                        Text { x: 8px; text: "Inspector"; color: Theme.paper; }
                    }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 8px;
                        alignment: start;
                        Text { text: root.item-name; color: Theme.paper; font-size: 18px; }
                        Text { text: root.item-kind; color: Theme.grey; }
                        Rectangle { height: 1px; background: Theme.line; }
                        Segmented { label: "Tab"; options: ["Tool", "Geometry", "Heights", "Passes", "Linking"]; current: 3; }
                        Rectangle { height: 1px; background: Theme.line; }
                        Text { text: "Tool: " + root.tool-name; color: Theme.grey; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { width: 90px; text: "Pattern"; color: Theme.paper; vertical-alignment: center; }
                            Segmented {
                                label: "Pattern";
                                options: ["Offset", "Raster"];
                                current: root.pattern;
                                select(i) => { root.pattern-selected(i); }
                            }
                        }
                        ScrubField {
                            label: "Stepover";
                            value-text: root.stepover-text;
                            message: root.stepover-message;
                            error: root.stepover-error;
                            scrub(dx) => { root.field-scrub("stepover", dx); }
                            entered(t) => { root.field-entered("stepover", t); }
                        }
                        ScrubField {
                            label: "Step down";
                            value-text: root.step-down-text;
                            message: root.step-down-message;
                            error: root.step-down-error;
                            scrub(dx) => { root.field-scrub("step_down", dx); }
                            entered(t) => { root.field-entered("step_down", t); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { width: 90px; text: "Direction"; color: Theme.paper; vertical-alignment: center; }
                            Segmented {
                                label: "Direction";
                                options: ["Climb", "Conventional"];
                                current: root.direction;
                                select(i) => { root.direction-selected(i); }
                            }
                        }
                        if root.pattern == 0: HorizontalLayout {
                            spacing: 8px;
                            Text { width: 90px; text: "Offset order"; color: Theme.paper; vertical-alignment: center; }
                            ComboBox {
                                model: ["Inside out", "Outside in"];
                                current-index: root.offset-order;
                                selected => { root.offset-order-selected(self.current-index); }
                            }
                        }
                        if root.pattern == 1: ScrubField {
                            label: "Pass angle";
                            value-text: root.angle-text;
                            scrub(dx) => { root.field-scrub("pass_angle_deg", dx); }
                            entered(t) => { root.field-entered("pass_angle_deg", t); }
                        }
                        CheckBox {
                            text: "Show pass preview on the model";
                            checked: root.preview;
                            toggled => { root.preview-toggled(); }
                        }
                    }
                }
            }
        }
        // Timeline.
        Rectangle {
            height: 40px;
            background: Theme.ink;
            HorizontalLayout {
                padding: 6px;
                spacing: 2px;
                for clip in root.clips: Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 4px;
                    background: clip.selected ? Theme.orange : Theme.raised;
                    Text { x: 6px; text: clip.name; color: Theme.paper; font-size: Theme.font-small; }
                }
            }
        }
    }
}
